<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <!-- Logo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎬 NIT FLEX"
            android:textColor="@color/primary_red"
            android:textSize="34sp"
            android:letterSpacing="0.08"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đăng ký tài khoản thành viên mới"
            android:textColor="@color/text_gray"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp" />

        <!-- Form Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/bg_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tạo Tài Khoản"
                    android:textColor="@color/text_white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="18dp" />

                <!-- Tên đăng nhập -->
                <EditText
                    android:id="@+id/etRegUsername"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_genre_chip"
                    android:hint="Tên đăng nhập (tối thiểu 3 ký tự)"
                    android:textColorHint="@color/text_gray_dark"
                    android:textColor="@color/text_white"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp"
                    android:inputType="textNoSuggestions"
                    android:maxLines="1" />

                <!-- Email -->
                <EditText
                    android:id="@+id/etRegEmail"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_genre_chip"
                    android:hint="Địa chỉ Email (ví dụ: user@gmail.com)"
                    android:inputType="textEmailAddress"
                    android:textColorHint="@color/text_gray_dark"
                    android:textColor="@color/text_white"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp"
                    android:maxLines="1" />

                <!-- Số điện thoại nhận OTP -->
                <EditText
                    android:id="@+id/etRegPhone"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_genre_chip"
                    android:hint="Số điện thoại nhận OTP (ví dụ: 0912345678)"
                    android:inputType="phone"
                    android:textColorHint="@color/text_gray_dark"
                    android:textColor="@color/text_white"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp"
                    android:maxLines="1" />

                <!-- Mật khẩu -->
                <EditText
                    android:id="@+id/etRegPassword"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_genre_chip"
                    android:hint="Mật khẩu (tối thiểu 6 ký tự)"
                    android:inputType="textPassword"
                    android:textColorHint="@color/text_gray_dark"
                    android:textColor="@color/text_white"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp"
                    android:maxLines="1" />

                <!-- Xác nhận mật khẩu -->
                <EditText
                    android:id="@+id/etRegConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_genre_chip"
                    android:hint="Xác nhận mật khẩu"
                    android:inputType="textPassword"
                    android:textColorHint="@color/text_gray_dark"
                    android:textColor="@color/text_white"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="22dp"
                    android:maxLines="1" />

                <!-- Nút đăng ký -->
                <Button
                    android:id="@+id/btnRegister"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="ĐĂNG KÝ NGAY"
                    android:backgroundTint="@color/primary_red"
                    android:textColor="@color/text_white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Chuyển sang màn hình Đăng nhập -->
        <TextView
            android:id="@+id/tvGoToLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đã có tài khoản? Đăng nhập tại đây ➔"
            android:textColor="@color/primary_red"
            android:textSize="14sp"
            android:layout_marginTop="20dp"
            android:padding="8dp" />

    </LinearLayout>
</ScrollView>
