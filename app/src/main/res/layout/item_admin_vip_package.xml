<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvAdminPkgName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="👑 Gói VIP 1 Tháng"
                android:textColor="@color/accent_gold"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAdminPkgStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_vip_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="ĐANG BẬT"
                android:textColor="#000000"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="bottom">

            <TextView
                android:id="@+id/tvAdminPkgPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="59.000 ₫"
                android:textColor="@color/text_white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAdminPkgDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="/ 30 ngày (Mã: VIP_1M)"
                android:textColor="@color/text_gray"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAdminPkgDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Mở khóa toàn bộ phim bom tấn > 8.0 TMDB và trải nghiệm 4K không quảng cáo."
            android:textColor="@color/text_gray_light"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="@color/divider_color" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btnAdminPkgToggle"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="Bật / Tắt"
                android:textSize="12sp"
                android:textColor="@color/text_white"
                android:backgroundTint="#3A3A3C"
                android:paddingHorizontal="12dp"
                android:paddingVertical="0dp" />

            <Button
                android:id="@+id/btnAdminPkgEdit"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:text="Chỉnh sửa"
                android:textSize="12sp"
                android:textColor="@color/text_white"
                android:backgroundTint="#007AFF"
                android:paddingHorizontal="12dp"
                android:paddingVertical="0dp" />

            <Button
                android:id="@+id/btnAdminPkgDelete"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:text="Xóa"
                android:textSize="12sp"
                android:textColor="@color/text_white"
                android:backgroundTint="@color/primary_red_dark"
                android:paddingHorizontal="12dp"
                android:paddingVertical="0dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
