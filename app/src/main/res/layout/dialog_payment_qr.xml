<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="16dp"
    app:cardBackgroundColor="@color/bg_card_elevated">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <!-- Top Header -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvQrDialogTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="QUÉT MÃ QR THANH TOÁN"
                    android:textColor="@color/accent_gold"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <ImageView
                    android:id="@+id/btnQrClose"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="end|center_vertical"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="@color/text_gray"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Đóng" />
            </FrameLayout>

            <!-- Package & Price Pill -->
            <TextView
                android:id="@+id/tvQrPackageInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_genre_chip"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:layout_marginTop="10dp"
                android:text="👑 Gói VIP 1 Tháng • 59.000 đ"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- QR Code Box -->
            <FrameLayout
                android:layout_width="230dp"
                android:layout_height="230dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_qr_box">

                <ImageView
                    android:id="@+id/imgQrCode"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="Mã QR Thanh Toán" />

                <ProgressBar
                    android:id="@+id/pbQrLoading"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/primary_red" />
            </FrameLayout>

            <!-- Countdown Timer -->
            <TextView
                android:id="@+id/tvCountdownTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="⏱️ Mã QR hết hạn sau: 15:00"
                android:textColor="@color/accent_gold"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Transfer Info Details Table -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_vip_package_normal"
                android:padding="12dp"
                android:layout_marginTop="12dp">

                <!-- Bank -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Ngân hàng:"
                        android:textColor="@color/text_gray"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvBankName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MB Bank (Quân Đội)"
                        android:textColor="@color/text_white"
                        android:textStyle="bold"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Account Number + Copy -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Số tài khoản:"
                        android:textColor="@color/text_gray"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvAccountNo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0335968888"
                        android:textColor="@color/accent_gold"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/btnCopyAccountNo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📋 Chép"
                        android:textColor="@color/text_white"
                        android:background="@drawable/bg_genre_chip"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:textSize="10sp"
                        android:layout_marginStart="8dp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Account Holder -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Chủ tài khoản:"
                        android:textColor="@color/text_gray"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NIT FLEX ENTERTAINMENT"
                        android:textColor="@color/text_white"
                        android:textStyle="bold"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Amount -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Số tiền:"
                        android:textColor="@color/text_gray"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvTransferAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="59.000 đ"
                        android:textColor="@color/accent_gold"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Transfer Content + Copy -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Nội dung CK:"
                        android:textColor="@color/text_gray"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvTransferContent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NITFLEX 1 VIP_1M"
                        android:textColor="@color/accent_gold"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/btnCopyContent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📋 Chép"
                        android:textColor="@color/text_white"
                        android:background="@drawable/bg_genre_chip"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:textSize="10sp"
                        android:layout_marginStart="8dp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

            </LinearLayout>

            <!-- Confirmation Button -->
            <Button
                android:id="@+id/btnConfirmPaid"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:text="✅ TÔI ĐÃ CHUYỂN KHOẢN THÀNH CÔNG"
                android:backgroundTint="@color/accent_gold"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="13sp" />

            <!-- Cancel Button -->
            <TextView
                android:id="@+id/btnCancelPayment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quay lại chọn gói khác"
                android:textColor="@color/text_gray"
                android:textSize="12sp"
                android:padding="8dp"
                android:layout_marginTop="4dp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </ScrollView>
</androidx.cardview.widget.CardView>
