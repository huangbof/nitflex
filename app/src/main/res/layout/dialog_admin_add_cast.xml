<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_surface"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎭 Thêm Diễn Viên Vào Phim"
        android:textColor="@color/text_white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Bổ sung thông tin diễn viên &amp; nhân vật vào cơ sở dữ liệu"
        android:textColor="@color/text_gray"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Tên diễn viên:"
        android:textColor="@color/text_gray"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etAdminCastActor"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_input_field"
        android:hint="Ví dụ: Tom Cruise"
        android:textColor="@color/text_white"
        android:textColorHint="@color/text_gray_dark"
        android:paddingHorizontal="12dp"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Tên vai diễn / nhân vật:"
        android:textColor="@color/text_gray"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etAdminCastCharacter"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_input_field"
        android:hint="Ví dụ: Pete 'Maverick' Mitchell"
        android:textColor="@color/text_white"
        android:textColorHint="@color/text_gray_dark"
        android:paddingHorizontal="12dp"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Link ảnh chân dung (URL TMDb hoặc web):"
        android:textColor="@color/text_gray"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etAdminCastProfile"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_input_field"
        android:hint="https://image.tmdb.org/t/p/w500/..."
        android:textColor="@color/text_white"
        android:textColorHint="@color/text_gray_dark"
        android:paddingHorizontal="12dp"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="18dp"
        android:gravity="end">

        <Button
            android:id="@+id/btnAdminCastCancel"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Hủy"
            android:textColor="@color/text_white"
            android:backgroundTint="#3A3A3C"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnAdminCastSave"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:text="Thêm Diễn Viên"
            android:textColor="@color/text_white"
            android:backgroundTint="@color/primary_red"
            android:textStyle="bold"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
