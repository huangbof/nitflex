<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/searchRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- Search Header with dynamic safe insets -->
    <LinearLayout
        android:id="@+id/searchHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="@color/bg_surface">

        <ImageButton
            android:id="@+id/btnSearchBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_genre_chip"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/text_white"
            android:contentDescription="Quay lại" />

        <EditText
            android:id="@+id/etSearchQuery"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_genre_chip"
            android:hint="Tìm phim (Avengers, Avatar...)"
            android:textColorHint="@color/text_gray_dark"
            android:textColor="@color/text_white"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textSize="13sp"
            android:imeOptions="actionSearch"
            android:inputType="text" />

        <Button
            android:id="@+id/btnDoSearch"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:text="TÌM"
            android:backgroundTint="@color/primary_red"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnOpenFilter"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_genre_chip"
            android:src="@drawable/ic_filter"
            app:tint="@color/text_white"
            android:contentDescription="Bộ lọc nâng cao"
            android:padding="9dp" />
    </LinearLayout>

    <!-- Active Filter Banner (hiển thị khi có bộ lọc nâng cao) -->
    <LinearLayout
        android:id="@+id/layoutActiveFilterBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2A1B1B"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvActiveFilterDesc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚡ Bộ lọc: VIP • 2020-Nay"
            android:textColor="@color/accent_gold"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnClearFilterBanner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:text="✕ Đặt lại"
            android:textColor="@color/text_gray_light"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Advanced Filter & Sort Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="#141414">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <!-- Sort Chips -->
            <TextView
                android:id="@+id/chipSortPopular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥 Phổ biến"
                android:textColor="@color/text_white"
                android:textSize="12sp"
                android:background="@drawable/bg_genre_chip_selected"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/chipSortRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⭐ Điểm cao"
                android:textColor="@color/text_white"
                android:textSize="12sp"
                android:background="@drawable/bg_genre_chip"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/chipSortLatest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅 Mới nhất"
                android:textColor="@color/text_white"
                android:textSize="12sp"
                android:background="@drawable/bg_genre_chip"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginEnd="8dp" />

            <!-- Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="18dp"
                android:background="@color/divider_color"
                android:layout_marginEnd="8dp" />

            <!-- Genre Chips -->
            <TextView
                android:id="@+id/chipGenreAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tất cả"
                android:textColor="@color/text_white"
                android:textSize="12sp"
                android:background="@drawable/bg_genre_chip_selected"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/chipGenreAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hành động"
                android:textColor="@color/text_white"
                android:textSize="12sp"
                android:background="@drawable/bg_genre_chip"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/chipGenreAnime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hoạt hình / Anime"
                android:textColor="@color/text_white"
                android:textSize="12sp"
                android:background="@drawable/bg_genre_chip"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/chipGenreSciFi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Viễn tưởng"
                android:textColor="@color/text_white"
                android:textSize="12sp"
                android:background="@drawable/bg_genre_chip"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/chipGenreCrime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tội phạm"
                android:textColor="@color/text_white"
                android:textSize="12sp"
                android:background="@drawable/bg_genre_chip"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/chipGenreDrama"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tâm lý"
                android:textColor="@color/text_white"
                android:textSize="12sp"
                android:background="@drawable/bg_genre_chip"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSearchResults"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="6dp"
            android:clipToPadding="false" />

        <LinearLayout
            android:id="@+id/layoutEmptySearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_search"
                app:tint="@color/text_gray_dark"
                android:contentDescription="Search" />

            <TextView
                android:id="@+id/tvEmptySearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Nhập tên phim để bắt đầu tìm kiếm"
                android:textColor="@color/text_gray"
                android:textSize="14sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/searchLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/primary_red"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
